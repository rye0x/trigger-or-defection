// Zed project settings for the LaTeX extension (texlab LSP).
// Saving any .tex file rebuilds build/main.pdf via latexmk (.latexmkrc).
{
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "rootDirectory": ".",
          "build": {
            "executable": "latexmk",
            "args": [],
            "onSave": true,
            "auxDirectory": "build",
            "pdfDirectory": "build"
          },
          "chktex": { "onOpenAndSave": false }
        }
      }
    }
  },
  "languages": {
    "LaTeX": { "soft_wrap": "editor_width", "tab_size": 2 }
  }
}
